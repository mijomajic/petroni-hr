{
	"name": "alderway-rental-demo",
	"private": true,
	"version": "1.0.0",
	"description": "Production-ready premium camper rental demo with booking requests, fleet, shop and administration.",
	"type": "module",
	"engines": {
		"node": ">=22"
	},
	"scripts": {
		"dev": "vite dev",
		"build": "vite build",
		"preview": "wrangler dev",
		"deploy": "npm run build && wrangler deploy",
		"cf-typegen": "wrangler types",
		"prepare": "svelte-kit sync || echo ''",
		"test": "tsx --test src/lib/*.test.ts",
		"test:pricing": "tsx --test src/lib/pricing.test.ts",
		"test:corvuspay": "tsx --test src/lib/corvuspay.test.ts",
		"test:seo": "tsx --test src/lib/legacy-redirects.test.ts",
		"test:checkout": "tsx --test src/lib/shop-checkout.test.ts",
		"report:404": "node scripts/summarize-404-log.mjs",
		"backup:production": "node scripts/backup/create-backup.mjs",
		"backup:restore-test": "node scripts/backup/restore-test.mjs",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch"
	},
	"devDependencies": {
		"@sveltejs/adapter-cloudflare": "^7.2.9",
		"@sveltejs/kit": "^2.57.0",
		"@sveltejs/vite-plugin-svelte": "^7.0.0",
		"@tailwindcss/vite": "^4.2.2",
		"@types/bwip-js": "^3.2.3",
		"@types/node": "^26.1.0",
		"svelte": "^5.55.2",
		"svelte-check": "^4.4.6",
		"tailwindcss": "^4.2.2",
		"tsx": "^4.22.5",
		"typescript": "^6.0.2",
		"vite": "^8.0.7",
		"wrangler": "^4.134.0"
	},
	"dependencies": {
		"@supabase/ssr": "^0.12.0",
		"@supabase/supabase-js": "^2.108.0",
		"bwip-js": "^4.11.2",
		"pdf-lib": "^1.17.1",
		"resend": "^6.16.0"
	}
}
