{
	"$schema": "./node_modules/wrangler/config-schema.json",
	"name": "alderway-rental-demo",
	"main": ".svelte-kit/cloudflare/_worker.js",
	"compatibility_date": "2026-09-18",
	"vars": {
		"PUBLIC_DEMO_MODE": "true"
	},
	"assets": {
		"binding": "ASSETS",
		"directory": ".svelte-kit/cloudflare"
	},
	"observability": {
		"enabled": true
	}
}
