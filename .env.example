PUBLIC_SUPABASE_URL=
PUBLIC_SUPABASE_ANON_KEY=
# Set this to the canonical public host before domain cutover, e.g. https://www.petroni.hr.
PUBLIC_SITE_URL=https://petroni-hr.vercel.app
# Optional public identifier supplied by BoxNow; the official locker widget also works without it.
PUBLIC_BOXNOW_PARTNER_ID=
SUPABASE_SERVICE_KEY=
CORVUSPAY_STORE_ID=
CORVUSPAY_SECRET_KEY=
CORVUSPAY_ENV=test
# mTLS credentials supplied by CorvusPay for transaction status/refund API access.
CORVUSPAY_API_CERT_PEM=
CORVUSPAY_API_KEY_PEM=
CORVUSPAY_API_KEY_PASSPHRASE=
# Vercel sends this value as a Bearer token to protected cron routes.
CRON_SECRET=
# Use test credentials locally. Add the production values only in Vercel's Production environment after a successful test payment.
RESEND_API_KEY=
RESEND_FROM_EMAIL=Petroni <onboarding@resend.dev>

# Phase 6H-D backup tooling. Do not place the passphrase or recovery secrets in this file/repository.
PETRONI_SUPABASE_PROJECT_REF=
PETRONI_BACKUP_DIR=
PETRONI_BACKUP_PASSPHRASE_FILE=
PETRONI_RECOVERY_SECRETS_FILE=
PETRONI_RESTORE_EVIDENCE_DIR=
PETRONI_POSTGRES_BIN=
