# Keep true for a standalone sales/demo deployment. Set false (or remove) when
# the deployment should read its public catalogue and content from Supabase.
PUBLIC_DEMO_MODE=true
PUBLIC_SUPABASE_URL=
PUBLIC_SUPABASE_ANON_KEY=
# Set this to the canonical public host before deployment.
PUBLIC_SITE_URL=https://demo.alderwaycampers.com
# Optional public identifier supplied by BoxNow; the official locker widget also works without it.
PUBLIC_BOXNOW_PARTNER_ID=
SUPABASE_SERVICE_KEY=
CORVUSPAY_STORE_ID=
CORVUSPAY_SECRET_KEY=
CORVUSPAY_ENV=test
# mTLS credentials supplied by CorvusPay for transaction status/refund API access.
CORVUSPAY_API_CERT_PEM=
CORVUSPAY_API_KEY_PEM=
CORVUSPAY_API_KEY_PASSPHRASE=
# Vercel sends this value as a Bearer token to protected cron routes.
CRON_SECRET=
# Use test credentials locally. Add the production values only in Vercel's Production environment after a successful test payment.
RESEND_API_KEY=
RESEND_FROM_EMAIL=Alderway Campers <onboarding@resend.dev>

# Do not place passphrases or recovery secrets in this file/repository.
RENTAL_SUPABASE_PROJECT_REF=
RENTAL_BACKUP_DIR=
RENTAL_BACKUP_PASSPHRASE_FILE=
RENTAL_RECOVERY_SECRETS_FILE=
RENTAL_RESTORE_EVIDENCE_DIR=
RENTAL_POSTGRES_BIN=
